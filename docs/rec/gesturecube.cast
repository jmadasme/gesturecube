[168.11, "o", "\u001b[90m 576\u001b[0m\u001b[90m │ \u001b[0m        STATE.model_error = (\u001b[90m\u001b[39;49;00m\n"]
[168.165, "o", "\u001b[90m 577\u001b[0m\u001b[90m │ \u001b[0m            \u001b[33m\"\u001b[39;49;00m\u001b[33mMediaPipe nativo no disponible en este CPU; \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[168.22, "o", "\u001b[90m 578\u001b[0m\u001b[90m │ \u001b[0m            \u001b[33m\"\u001b[39;49;00m\u001b[33mla inferencia corre en el navegador\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[168.275, "o", "\u001b[90m 579\u001b[0m\u001b[90m │ \u001b[0m        )\u001b[90m\u001b[39;49;00m\n"]
[168.33, "o", "\u001b[90m 580\u001b[0m\u001b[90m │ \u001b[0m        logging.info(STATE.model_error)\u001b[90m\u001b[39;49;00m\n"]
[168.385, "o", "\u001b[90m 581\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94melif\u001b[39;49;00m model_path.is_file():\u001b[90m\u001b[39;49;00m\n"]
[168.44, "o", "\u001b[90m 582\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[168.495, "o", "\u001b[90m 583\u001b[0m\u001b[90m │ \u001b[0m            engine = GestureEngine(\u001b[96mstr\u001b[39;49;00m(model_path))\u001b[90m\u001b[39;49;00m\n"]
[168.55, "o", "\u001b[90m 584\u001b[0m\u001b[90m │ \u001b[0m            STATE.model_ok = \u001b[94mTrue\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[168.605, "o", "\u001b[90m 585\u001b[0m\u001b[90m │ \u001b[0m            logging.info(\u001b[33m\"\u001b[39;49;00m\u001b[33mMediaPipe HandLandmarker cargado: \u001b[39;49;00m\u001b[33m%s\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, model_path)\u001b[90m\u001b[39;49;00m\n"]
[168.66, "o", "\u001b[90m 586\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mexcept\u001b[39;49;00m \u001b[96mException\u001b[39;49;00m \u001b[94mas\u001b[39;49;00m exc:\u001b[90m\u001b[39;49;00m\n"]
[168.715, "o", "\u001b[90m 587\u001b[0m\u001b[90m │ \u001b[0m            STATE.model_error = \u001b[96mstr\u001b[39;49;00m(exc)\u001b[90m\u001b[39;49;00m\n"]
[168.77, "o", "\u001b[90m 588\u001b[0m\u001b[90m │ \u001b[0m            logging.warning(\u001b[33m\"\u001b[39;49;00m\u001b[33mNo se pudo cargar el motor nativo: \u001b[39;49;00m\u001b[33m%s\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, exc)\u001b[90m\u001b[39;49;00m\n"]
[168.825, "o", "\u001b[90m 589\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94melse\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[168.88, "o", "\u001b[90m 590\u001b[0m\u001b[90m │ \u001b[0m        STATE.model_error = \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mModelo no encontrado: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mmodel_path\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]

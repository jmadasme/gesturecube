[167.67, "o", "\u001b[90m 568\u001b[0m\u001b[90m │ \u001b[0m        level=logging.DEBUG \u001b[94mif\u001b[39;49;00m args.debug \u001b[94melse\u001b[39;49;00m logging.INFO,\u001b[90m\u001b[39;49;00m\n"]
[167.725, "o", "\u001b[90m 569\u001b[0m\u001b[90m │ \u001b[0m        \u001b[96mformat\u001b[39;49;00m=\u001b[33m\"\u001b[39;49;00m\u001b[33m%(asctime)s\u001b[39;49;00m\u001b[33m \u001b[39;49;00m\u001b[33m%(levelname)s\u001b[39;49;00m\u001b[33m \u001b[39;49;00m\u001b[33m%(message)s\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]

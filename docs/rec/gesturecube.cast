[121.861, "o", "\u001b[90m┌─ gesture_engine.py · _count_extended() / _classify() ─────────────────────────────────────────────────\u001b[0m\n"]
[121.861, "o", "\u001b[90m 214\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_count_extended\u001b[39;49;00m(points: \u001b[96mlist\u001b[39;49;00m[\u001b[96mtuple\u001b[39;49;00m[\u001b[96mfloat\u001b[39;49;00m, \u001b[96mfloat\u001b[39;49;00m, \u001b[96mfloat\u001b[39;49;00m]]) -> \u001b[96mint\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[121.916, "o", "\u001b[90m 215\u001b[0m\u001b[90m │ \u001b[0m        wrist = np.array(points[\u001b[94m0\u001b[39;49;00m], dtype=np.float32)\u001b[90m\u001b[39;49;00m\n"]
[121.971, "o", "\u001b[90m 216\u001b[0m\u001b[90m │ \u001b[0m        count = \u001b[94m0\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[122.026, "o", "\u001b[90m 217\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mfor\u001b[39;49;00m tip, pip \u001b[95min\u001b[39;49;00m \u001b[96mzip\u001b[39;49;00m(FINGER_TIPS, FINGER_PIPS):\u001b[90m\u001b[39;49;00m\n"]
[122.081, "o", "\u001b[90m 218\u001b[0m\u001b[90m │ \u001b[0m            d_tip = \u001b[96mfloat\u001b[39;49;00m(np.linalg.norm(np.array(points[tip], dtype=np.float32) - wrist))\u001b[90m\u001b[39;49;00m\n"]
[122.136, "o", "\u001b[90m 219\u001b[0m\u001b[90m │ \u001b[0m            d_pip = \u001b[96mfloat\u001b[39;49;00m(np.linalg.norm(np.array(points[pip], dtype=np.float32) - wrist))\u001b[90m\u001b[39;49;00m\n"]
[122.191, "o", "\u001b[90m 220\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mif\u001b[39;49;00m d_pip > \u001b[94m1e-6\u001b[39;49;00m \u001b[95mand\u001b[39;49;00m d_tip > d_pip * \u001b[94m1.15\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[122.246, "o", "\u001b[90m 221\u001b[0m\u001b[90m │ \u001b[0m                count += \u001b[94m1\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[122.301, "o", "\u001b[90m 222\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mreturn\u001b[39;49;00m count\u001b[90m\u001b[39;49;00m\n"]
[122.356, "o", "\u001b[90m 223\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]

[151.872, "o", "\u001b[90m 264\u001b[0m\u001b[90m │ \u001b[0m        now: \u001b[96mfloat\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[151.927, "o", "\u001b[90m 265\u001b[0m\u001b[90m │ \u001b[0m    ) -> \u001b[96mlist\u001b[39;49;00m[GestureEvent]:\u001b[90m\u001b[39;49;00m\n"]
[151.982, "o", "\u001b[90m 266\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m gesture != \u001b[33m\"\u001b[39;49;00m\u001b[33mopen\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[152.037, "o", "\u001b[90m 267\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mreturn\u001b[39;49;00m []\u001b[90m\u001b[39;49;00m\n"]
[152.092, "o", "\u001b[90m 268\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m now < \u001b[96mself\u001b[39;49;00m._cooldown_until[handedness]:\u001b[90m\u001b[39;49;00m\n"]
[152.147, "o", "\u001b[90m 269\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mreturn\u001b[39;49;00m []\u001b[90m\u001b[39;49;00m\n"]

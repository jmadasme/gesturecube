[10.452, "o", "\u001b[90m┌─ app.py · cabecera ───────────────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[10.452, "o", "\u001b[90m   1\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#!/usr/bin/env python3\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[10.507, "o", "\u001b[90m   2\u001b[0m\u001b[90m │ \u001b[0m\u001b[33m\"\"\"\u001b[39;49;00m\u001b[33mGestureCube UNO Q.\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[10.562, "o", "\u001b[90m   3\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[10.617, "o", "\u001b[90m   4\u001b[0m\u001b[90m │ \u001b[0mServidor HTTP liviano (stdlib) + cámara USB + MediaPipe HandLandmarker.\u001b[90m\u001b[39;49;00m\n"]
[10.672, "o", "\u001b[90m   5\u001b[0m\u001b[90m │ \u001b[0mSirve una página con un cubo Rubik \u001b[94m3\u001b[39;49;00mD y transmite los gestos por SSE.\u001b[90m\u001b[39;49;00m\n"]
[10.727, "o", "\u001b[90m   6\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[10.782, "o", "\u001b[90m   7\u001b[0m\u001b[90m │ \u001b[0mNo usa FastAPI ni frameworks externos: solo OpenCV, NumPy y MediaPipe.\u001b[90m\u001b[39;49;00m\n"]
[10.837, "o", "\u001b[90m   8\u001b[0m\u001b[90m │ \u001b[0m\u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[10.892, "o", "\u001b[90m   9\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[10.947, "o", "\u001b[90m  10\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mfrom\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[04m\u001b[96m__future__\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[94mimport\u001b[39;49;00m annotations\u001b[90m\u001b[39;49;00m\n"]

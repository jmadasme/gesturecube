[167.285, "o", "\u001b[90m 561\u001b[0m\u001b[90m │ \u001b[0m    parser.add_argument(\u001b[33m\"\u001b[39;49;00m\u001b[33m--camera\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, default=os.environ.get(\u001b[33m\"\u001b[39;49;00m\u001b[33mGESTURECUBE_CAMERA\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m))\u001b[90m\u001b[39;49;00m\n"]
[167.34, "o", "\u001b[90m 562\u001b[0m\u001b[90m │ \u001b[0m    parser.add_argument(\u001b[33m\"\u001b[39;49;00m\u001b[33m--model\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, default=\u001b[96mstr\u001b[39;49;00m(DEFAULT_MODEL))\u001b[90m\u001b[39;49;00m\n"]
[167.395, "o", "\u001b[90m 563\u001b[0m\u001b[90m │ \u001b[0m    parser.add_argument(\u001b[33m\"\u001b[39;49;00m\u001b[33m--no-mirror\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, action=\u001b[33m\"\u001b[39;49;00m\u001b[33mstore_true\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]

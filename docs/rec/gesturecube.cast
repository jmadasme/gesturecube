[151.762, "o", "\u001b[90m 262\u001b[0m\u001b[90m │ \u001b[0m        palm: \u001b[96mtuple\u001b[39;49;00m[\u001b[96mfloat\u001b[39;49;00m, \u001b[96mfloat\u001b[39;49;00m],\u001b[90m\u001b[39;49;00m\n"]

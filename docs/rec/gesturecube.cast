[122.466, "o", "\u001b[90m 225\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_classify\u001b[39;49;00m(fingers: \u001b[96mint\u001b[39;49;00m) -> \u001b[96mstr\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[122.521, "o", "\u001b[90m 226\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m fingers <= \u001b[94m1\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[122.576, "o", "\u001b[90m 227\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mreturn\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33mfist\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]

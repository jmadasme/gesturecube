[70.013, "o", "\u001b[90m┌─ app.py · _draw_overlay() ────────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[70.013, "o", "\u001b[90m 370\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_draw_overlay\u001b[39;49;00m(frame, hands: \u001b[96mlist\u001b[39;49;00m[HandState]) -> \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[70.068, "o", "\u001b[90m 371\u001b[0m\u001b[90m │ \u001b[0m        h, w = frame.shape[:\u001b[94m2\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\n"]
[70.123, "o", "\u001b[90m 372\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mfor\u001b[39;49;00m hand \u001b[95min\u001b[39;49;00m hands:\u001b[90m\u001b[39;49;00m\n"]
[70.178, "o", "\u001b[90m 373\u001b[0m\u001b[90m │ \u001b[0m            color = (\u001b[94m0\u001b[39;49;00m, \u001b[94m220\u001b[39;49;00m, \u001b[94m255\u001b[39;49;00m) \u001b[94mif\u001b[39;49;00m hand.handedness == \u001b[33m\"\u001b[39;49;00m\u001b[33mRight\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[94melse\u001b[39;49;00m (\u001b[94m255\u001b[39;49;00m, \u001b[94m80\u001b[39;49;00m, \u001b[94m200\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[70.233, "o", "\u001b[90m 374\u001b[0m\u001b[90m │ \u001b[0m            points = [(\u001b[96mint\u001b[39;49;00m(x * w), \u001b[96mint\u001b[39;49;00m(y * h)) \u001b[94mfor\u001b[39;49;00m x, y, _z \u001b[95min\u001b[39;49;00m hand.landmarks]\u001b[90m\u001b[39;49;00m\n"]
[70.288, "o", "\u001b[90m 375\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mfor\u001b[39;49;00m a, b \u001b[95min\u001b[39;49;00m HAND_CONNECTIONS:\u001b[90m\u001b[39;49;00m\n"]
[70.343, "o", "\u001b[90m 376\u001b[0m\u001b[90m │ \u001b[0m                \u001b[94mif\u001b[39;49;00m a < \u001b[96mlen\u001b[39;49;00m(points) \u001b[95mand\u001b[39;49;00m b < \u001b[96mlen\u001b[39;49;00m(points):\u001b[90m\u001b[39;49;00m\n"]
[70.398, "o", "\u001b[90m 377\u001b[0m\u001b[90m │ \u001b[0m                    cv2.line(frame, points[a], points[b], color, \u001b[94m2\u001b[39;49;00m, cv2.LINE_AA)\u001b[90m\u001b[39;49;00m\n"]
[70.453, "o", "\u001b[90m 378\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mfor\u001b[39;49;00m x, y \u001b[95min\u001b[39;49;00m points:\u001b[90m\u001b[39;49;00m\n"]
[70.508, "o", "\u001b[90m 379\u001b[0m\u001b[90m │ \u001b[0m                cv2.circle(frame, (x, y), \u001b[94m4\u001b[39;49;00m, (\u001b[94m255\u001b[39;49;00m, \u001b[94m255\u001b[39;49;00m, \u001b[94m255\u001b[39;49;00m), -\u001b[94m1\u001b[39;49;00m, cv2.LINE_AA)\u001b[90m\u001b[39;49;00m\n"]
[70.563, "o", "\u001b[90m 380\u001b[0m\u001b[90m │ \u001b[0m                cv2.circle(frame, (x, y), \u001b[94m5\u001b[39;49;00m, color, \u001b[94m1\u001b[39;49;00m, cv2.LINE_AA)\u001b[90m\u001b[39;49;00m\n"]
[70.618, "o", "\u001b[90m 381\u001b[0m\u001b[90m │ \u001b[0m            label = \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mhand.handedness.upper()\u001b[33m}\u001b[39;49;00m\u001b[33m  \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mhand.gesture.upper()\u001b[33m}\u001b[39;49;00m\u001b[33m  \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mhand.fingers\u001b[33m}\u001b[39;49;00m\u001b[33m dedos\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[70.673, "o", "\u001b[90m 382\u001b[0m\u001b[90m │ \u001b[0m            (tw, th), _ = cv2.getTextSize(label, cv2.FONT_HERSHEY_SIMPLEX, \u001b[94m0.55\u001b[39;49;00m, \u001b[94m1\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[70.728, "o", "\u001b[90m 383\u001b[0m\u001b[90m │ \u001b[0m            x0, y0 = \u001b[94m18\u001b[39;49;00m, \u001b[94m18\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[70.783, "o", "\u001b[90m 384\u001b[0m\u001b[90m │ \u001b[0m            cv2.rectangle(frame, (x0 - \u001b[94m8\u001b[39;49;00m, y0 - \u001b[94m6\u001b[39;49;00m), (x0 + tw + \u001b[94m8\u001b[39;49;00m, y0 + th + \u001b[94m8\u001b[39;49;00m), (\u001b[94m5\u001b[39;49;00m, \u001b[94m8\u001b[39;49;00m, \u001b[94m14\u001b[39;49;00m), -\u001b[94m1\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[70.838, "o", "\u001b[90m 385\u001b[0m\u001b[90m │ \u001b[0m            cv2.putText(frame, label, (x0, y0 + th), cv2.FONT_HERSHEY_SIMPLEX,\u001b[90m\u001b[39;49;00m\n"]
[70.893, "o", "\u001b[90m 386\u001b[0m\u001b[90m │ \u001b[0m                        \u001b[94m0.55\u001b[39;49;00m, color, \u001b[94m1\u001b[39;49;00m, cv2.LINE_AA)\u001b[90m\u001b[39;49;00m\n"]
[70.948, "o", "\u001b[90m 387\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]

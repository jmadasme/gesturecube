[167.945, "o", "\u001b[90m 573\u001b[0m\u001b[90m │ \u001b[0m    engine = \u001b[94mNone\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[168.0, "o", "\u001b[90m 574\u001b[0m\u001b[90m │ \u001b[0m    model_path = Path(args.model)\u001b[90m\u001b[39;49;00m\n"]
